<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Top Header: Sender Name & Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                tools:text="Ali Bhai (WhatsApp)" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                tools:text="10:45:20 AM" />
        </LinearLayout>

        <!-- Status & Engine Badges Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status Chip -->
            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="SENT" />

            <!-- Engine Badge -->
            <TextView
                android:id="@+id/tvEngineBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/ic_launcher_background"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                tools:text="Gemini 1.5/2.0" />

            <!-- Attempt Counter -->
            <TextView
                android:id="@+id/tvAttemptBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                tools:text="• Attempt 1/3" />

            <!-- Latency / Duration -->
            <TextView
                android:id="@+id/tvDurationBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                tools:text="• 1.2s" />
        </LinearLayout>

        <!-- Incoming Message -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#F1F5F9"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dost Ka Message:"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvIncomingMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="Oye bhai kahan hai? Match dekhne chalna hai sham ko?" />
        </LinearLayout>

        <!-- Outgoing Roman Urdu AI Reply -->
        <LinearLayout
            android:id="@+id/layoutReplyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@color/bubble_ai"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Dost Ka Jawab (Roman Urdu):"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#064E3B"
                android:textSize="13.5sp"
                tools:text="Haan yaar scene on hai! Main 6 baje tak free hota hoon, phir sath nikalte hain." />
        </LinearLayout>

        <!-- Error & Retry Diagnostic Details Box -->
        <LinearLayout
            android:id="@+id/layoutErrorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FEF2F2"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvErrorHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Error / Diagnostic Details:"
                android:textColor="#B91C1C"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvErrorReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="#991B1B"
                android:textSize="11sp"
                tools:text="Gemini HTTP 429: Too Many Requests -> Retried with Pollinations Fallback (Success)" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
